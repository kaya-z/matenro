// Pins of the Matenro machine on the Sipeed Tang Nano 20K (GW2AR-LV18QN88C8/I7).
// The numbers are those of the .cst files of github.com/sipeed/TangNano-20K-example (clock, S1/S2, LEDs, UART, SD card (nestang)); the SDRAM in the
// package has no pin constraints (its ports are found by name).  NOT yet checked on a board.
IO_LOC "sys_clk" 4;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "s1" 88;
IO_PORT "s1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;       // high when pressed
IO_LOC "s2" 87;
IO_PORT "s2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;       // high when pressed
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// the microSD slot (SPI mode: CLK, CMD = MOSI, DAT0 = MISO, DAT3 = CS)
IO_LOC "sd_clk" 83;
IO_PORT "sd_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "sd_mosi" 82;
IO_PORT "sd_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "sd_miso" 84;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "sd_cs" 81;
IO_PORT "sd_cs" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
// the 6 LEDs, low active
IO_LOC "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
