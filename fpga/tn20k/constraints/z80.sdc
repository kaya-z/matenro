// SPDX-License-Identifier: MIT
// The Z80 of the Tang Nano 20K (z80_sub.v, instance soc/subz, CZ_DIV system clocks per Z80 clock): the registers of the TV80 core only change when
// the clock enable is set (once in CZ_DIV clocks, never earlier), so a path from a register of the core to another one, or to the pins of its register file
// (the RAM cells RegsH / RegsL), has CZ_DIV clocks, not one.  The same constraints as fpga/tn9k/constraints/matenro.sdc for the first group (build.sh fills
// in @CZ@ and @CZ1@).  The paths of the bus wrapper are left at one clock.
set_multicycle_path -from [get_regs {soc/subz/cpu/i_tv80_core/*}] -to [get_regs {soc/subz/cpu/i_tv80_core/*}] -setup -end @CZ@
set_multicycle_path -from [get_regs {soc/subz/cpu/i_tv80_core/*}] -to [get_regs {soc/subz/cpu/i_tv80_core/*}] -hold -start @CZ1@
set_multicycle_path -from [get_regs {soc/subz/cpu/i_tv80_core/*}] -to [get_pins {soc/subz/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/DI[0] soc/subz/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/DI[1] soc/subz/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/DI[2] soc/subz/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/DI[3] soc/subz/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/WAD[0] soc/subz/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/WAD[1] soc/subz/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/WAD[2] soc/subz/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/WAD[3] soc/subz/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/WRE}] -setup -end @CZ@
