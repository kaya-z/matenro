// SPDX-License-Identifier: MIT
// Timing constraints of the Z80 of the Matenro SoC (rtl/z80_sub.v, CZ_DIV = 9).
// The registers of the core only change when the clock enable is set (once in nine system clocks, never earlier), so a
// path from a register of the core to another one, or to the pins of its register file (twelve RAM cells RegsH / RegsL,
// named one by one: get_regs does not find RAM cells and a wildcard does not find their pins), has nine clocks, not one.
// The registers of the bus wrapper take their value four clocks after the clock enable: five clocks for the paths from
// the core to them, four for the paths back to the core.  The data bus di_q settles at least three clocks before the clock
// enable (z80_sub.v holds the enable five clocks after an access; the cycle start is long before), so the paths from
// di_q into the core have three clocks.  The register read mux of the XLINK (m_rdata) is read by the 6809 at least
// eighteen clocks after its address is set: three clocks.
// The Gowin tool takes a multicycle constraint only with both -from and -to, stops at a pin that does not exist (the cells
// ..._s1 are read ports: AD, DI, WRE; the others: DI, WAD, WRE) and reads at most about 4000 characters of a list.
set_multicycle_path -from [get_regs {soc/sub/cpu/i_tv80_core/*}] -to [get_regs {soc/sub/cpu/i_tv80_core/*}] -setup -end 9
set_multicycle_path -from [get_regs {soc/sub/cpu/i_tv80_core/*}] -to [get_regs {soc/sub/cpu/i_tv80_core/*}] -hold -start 8
set_multicycle_path -from [get_regs {soc/sub/cpu/i_tv80_core/*}] -to [get_pins {soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/DI[0] soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/DI[1] soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/DI[2] soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/DI[3] soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/WAD[0] soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/WAD[1] soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/WAD[2] soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/WAD[3] soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/WRE}] -setup -end 9
set_multicycle_path -from [get_regs {soc/sub/cpu/i_tv80_core/*}] -to [get_pins {soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/DI[0] soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/DI[1] soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/DI[2] soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/DI[3] soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/WAD[0] soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/WAD[1] soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/WAD[2] soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/WAD[3] soc/sub/cpu/i_tv80_core/i_reg/RegsH_RegsH_0_0_s/WRE}] -hold -start 8
